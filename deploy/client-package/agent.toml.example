# 易学 IDV — 学生机通用配置（批量部署用）
#
# 金样机镜像里只需放这一份配置；500 台机器共用，不需要逐台修改。
# 首次开机后 Agent 会自动：
#   - 取“到 Center 路由网卡”的 MAC（不用手填）
#   - 向 Center 登记，由 Center 按机房规则分配 stu0NN 与 IP
#   - 改名 / 配网 / 开还原保护（首启 2~3 次重启内收敛）

center_url = "http://10.110.0.1:8080"

# MAC：留空或 "auto" = 自动探测（推荐）。仅在排障/固定测试时显式填写。
# mac = ""

# 主机名：留空 = 使用当前计算机名；一般不要填，避免所有机器同名。
# hostname = ""

log = "info,idv_agent=info"

# auto | uwf | state_file
restore_backend = "auto"
